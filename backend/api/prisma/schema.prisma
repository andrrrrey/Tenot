generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  PUBLISHED
  DRAFT
}

enum CityType {
  REGION
  CITY
  VILLAGE
  TOWN
  DISTRICT
}

enum CategoryFieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  MULTISELECT
}

model City {
  id       Int      @id @default(autoincrement())
  name     String
  type     CityType @default(CITY)
  regionId Int?

  region   City?  @relation("CityRegion", fields: [regionId], references: [id])
  children City[] @relation("CityRegion")

  users    User[]
  listings Listing[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  avatarUrl String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  cityId Int?
  city   City? @relation(fields: [cityId], references: [id])

  listings Listing[]

  messages Message[]

  initiatedChats Chat[] @relation("InitiatorChats")
  receivedChats  Chat[] @relation("OwnerChats")

  favorites Favorite[]

  authoredReviews Review[] @relation("AuthoredReviews")
  receivedReviews Review[] @relation("ReceivedReviews")
}

model CarMake {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  models   CarModel[]
  listings Listing[]
}

model CarModel {
  id         Int     @id @default(autoincrement())
  name       String
  generation String?
  makeId     Int
  yearFrom   Int
  yearTo     Int?

  make     CarMake   @relation(fields: [makeId], references: [id])
  listings Listing[]

  @@unique([name, makeId])
}

model Category {
  id            Int     @id @default(autoincrement())
  name          String
  imageUrl      String?
  hasCarFilter  Boolean @default(false)
  filterProfile String?
  templateKey   String? @unique

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  listings Listing[]
  fields   CategoryField[]
}

model CategoryField {
  id         Int               @id @default(autoincrement())
  categoryId Int
  key        String
  label      String
  type       CategoryFieldType @default(TEXT)
  unit       String?
  options    Json?
  required   Boolean           @default(false)
  filterable Boolean           @default(true)
  showInForm Boolean           @default(true)
  sortOrder  Int               @default(0)

  category Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  values   ListingAttribute[]

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
}

model Listing {
  id          Int           @id @default(autoincrement())
  title       String
  article     String        @default("")
  description String
  price       Float
  isActive    Boolean       @default(true)
  status      ListingStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())

  userId     Int
  categoryId Int
  cityId     Int?
  carMakeId  Int?
  carModelId Int?
  carYear    Int?

  user     User      @relation(fields: [userId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])
  city     City?     @relation(fields: [cityId], references: [id])
  carMake  CarMake?  @relation(fields: [carMakeId], references: [id])
  carModel CarModel? @relation(fields: [carModelId], references: [id])

  images     ListingImage[]
  chats      Chat[]
  favorites  Favorite[]
  reviews    Review[]
  attributes ListingAttribute[]
}

model ListingAttribute {
  id              Int      @id @default(autoincrement())
  listingId       Int
  categoryFieldId Int
  textValue       String?
  numberValue     Float?
  booleanValue    Boolean?
  jsonValue       Json?

  listing Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  field   CategoryField @relation(fields: [categoryFieldId], references: [id], onDelete: Cascade)

  @@unique([listingId, categoryFieldId])
  @@index([categoryFieldId, textValue])
  @@index([categoryFieldId, numberValue])
  @@index([categoryFieldId, booleanValue])
}

model ListingImage {
  id        Int     @id @default(autoincrement())
  url       String
  type      String  @default("image")
  isCover   Boolean @default(false)
  order     Int     @default(0)
  listingId Int

  listing Listing @relation(fields: [listingId], references: [id])
}

model Chat {
  id Int @id @default(autoincrement())

  initiatorId Int
  ownerId     Int
  listingId   Int

  initiator User    @relation("InitiatorChats", fields: [initiatorId], references: [id])
  owner     User    @relation("OwnerChats", fields: [ownerId], references: [id])
  listing   Listing @relation(fields: [listingId], references: [id])

  messages Message[]
}

model Message {
  id            Int      @id @default(autoincrement())
  chatId        Int
  senderId      Int
  text          String?
  audioUrl      String?
  audioDuration Float?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation(fields: [senderId], references: [id])
}

model Favorite {
  id        Int @id @default(autoincrement())
  userId    Int
  listingId Int

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

model Review {
  id           Int          @id @default(autoincrement())
  authorId     Int
  targetId     Int
  rating       Int
  satisfaction String
  liked        String
  disliked     String
  listingId    Int?
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())

  author  User     @relation("AuthoredReviews", fields: [authorId], references: [id])
  target  User     @relation("ReceivedReviews", fields: [targetId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@unique([authorId, targetId])
}
