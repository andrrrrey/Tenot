generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CityType {
  REGION
  CITY
  VILLAGE
  TOWN
}

model City {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  type     CityType @default(CITY)
  regionId Int?

  region   City?  @relation("CityRegion", fields: [regionId], references: [id])
  children City[] @relation("CityRegion")

  users    User[]
  listings Listing[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  phone     String?
  avatarUrl String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  cityId Int?
  city   City? @relation(fields: [cityId], references: [id])

  listings Listing[]

  messages Message[]

  initiatedChats Chat[] @relation("InitiatorChats")
  receivedChats  Chat[] @relation("OwnerChats")

  favorites Favorite[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  imageUrl String?

  parentId Int?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  listings Listing[]
}

model Listing {
  id          Int      @id @default(autoincrement())
  title       String
  article     String   @default("")
  description String
  price       Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userId     Int
  categoryId Int
  cityId     Int?

  user     User     @relation(fields: [userId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])
  city     City?    @relation(fields: [cityId], references: [id])

  images    ListingImage[]
  chats     Chat[]
  favorites Favorite[]
}

model ListingImage {
  id        Int    @id @default(autoincrement())
  url       String
  listingId Int

  listing Listing @relation(fields: [listingId], references: [id])
}

model Chat {
  id Int @id @default(autoincrement())

  initiatorId Int
  ownerId     Int
  listingId   Int

  initiator User    @relation("InitiatorChats", fields: [initiatorId], references: [id])
  owner     User    @relation("OwnerChats", fields: [ownerId], references: [id])
  listing   Listing @relation(fields: [listingId], references: [id])

  messages Message[]
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  senderId  Int
  text      String
  createdAt DateTime @default(now())

  chat   Chat @relation(fields: [chatId], references: [id])
  sender User @relation(fields: [senderId], references: [id])
}

model Favorite {
  id        Int @id @default(autoincrement())
  userId    Int
  listingId Int

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}
